# FORMLESS SUBSTRATE v5
# Minimal Apple Silicon bootc image - Formless IS the OS
#
# ARCHITECTURE:
#   Single stage build on Fedora Asahi Remix base-atomic
#   Base already includes: Asahi kernel, Mesa, audio, NetworkManager
#   We add: SSH hardening, Tailscale, Homebrew bootstrap, formless user
#
# BASE: quay.io/fedora-asahi-remix-atomic-desktops/base-atomic:42
#   - Asahi kernel (6.17.12-400.asahi.fc42.aarch64+16k)
#   - Mesa with Asahi GPU drivers
#   - PipeWire + speakersafetyd
#   - NetworkManager + iwd
#   - Podman
#
# PACKAGE MANAGEMENT:
#   System: OSTree layers (baked at build time)
#   User:   Homebrew (installed on first boot)
#   Apps:   Podman containers

# =============================================================================
# BUILD ARGUMENTS
# =============================================================================
ARG BASE_IMAGE="quay.io/fedora-asahi-remix-atomic-desktops/base-atomic:42"

# =============================================================================
# SINGLE STAGE BUILD
# =============================================================================
FROM ${BASE_IMAGE}

# Metadata
LABEL org.opencontainers.image.title="Formless Substrate"
LABEL org.opencontainers.image.description="Minimal Apple Silicon OS - Formless IS the interface"
LABEL org.opencontainers.image.source="https://github.com/Project-Mycelium/asahi-substrate"
LABEL containers.bootc="1"

# -----------------------------------------------------------------------------
# 1. Remove unnecessary packages from base image (saves ~800MB)
# -----------------------------------------------------------------------------
RUN dnf remove -y --setopt=install_weak_deps=False \
    firefox firefox-langpacks \
    ibus ibus-anthy ibus-anthy-python ibus-chewing ibus-gtk3 ibus-gtk4 \
    ibus-hangul ibus-libpinyin ibus-m17n ibus-setup ibus-typing-booster \
    geolite2-city geolite2-country \
    cldr-emoji-annotation cldr-emoji-annotation-dtd \
    google-noto-color-emoji-fonts google-noto-emoji-fonts \
    default-fonts-core-emoji \
    python3-botocore \
    qcom-firmware \
    || true

# -----------------------------------------------------------------------------
# 2. Install additional packages via DNF (base-atomic has DNF available)
# -----------------------------------------------------------------------------
RUN dnf install -y --setopt=install_weak_deps=False \
    openssh-server \
    tailscale \
    curl \
    git \
    jq \
    procps-ng \
    gcc \
    gcc-c++ \
    make \
    glibc-devel \
    plymouth \
    plymouth-theme-spinner \
    && dnf clean all

# -----------------------------------------------------------------------------
# 3. Remote Access Layer (SSH + Tailscale)
# -----------------------------------------------------------------------------
# SSH hardening - keys only
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -i 's/PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

# Bake in authorized keys
RUN mkdir -p /etc/skel/.ssh && chmod 700 /etc/skel/.ssh
COPY build_files/authorized_keys.d/*.pub /tmp/authorized_keys.d/
RUN cat /tmp/authorized_keys.d/*.pub > /etc/skel/.ssh/authorized_keys && \
    chmod 600 /etc/skel/.ssh/authorized_keys && \
    rm -rf /tmp/authorized_keys.d

# Tailscale auto-start service
COPY build_files/tailscale-autostart.service /usr/lib/systemd/system/

# SSH key setup service (ensures keys exist on every boot)
COPY build_files/formless-ssh-setup.service /usr/lib/systemd/system/

# Enable remote access services
RUN systemctl enable sshd.service && \
    systemctl enable tailscaled.service && \
    systemctl enable tailscale-autostart.service && \
    systemctl enable formless-ssh-setup.service

# -----------------------------------------------------------------------------
# 4. Audio Configuration
# -----------------------------------------------------------------------------
# Custom PipeWire config (base already has speakersafetyd enabled)
RUN rm -f /etc/pipewire/pipewire.conf.d/99-asahi.conf 2>/dev/null || true
COPY build_files/audio-fix.conf /etc/pipewire/pipewire.conf.d/99-substrate-quantum.conf

# Ensure speaker protection is enabled (CRITICAL for Apple Silicon)
RUN systemctl enable speakersafetyd.service 2>/dev/null || true

# -----------------------------------------------------------------------------
# 5. Power Management
# -----------------------------------------------------------------------------
COPY build_files/99-asahi-power.rules /etc/udev/rules.d/

# -----------------------------------------------------------------------------
# 6. Homebrew Bootstrap
# -----------------------------------------------------------------------------
# Create Homebrew directory structure
# Note: /home is a symlink to /var/home in bootc
RUN mkdir -p /var/home/linuxbrew/.linuxbrew && \
    chmod 775 /var/home/linuxbrew && \
    chown -R 1000:1000 /var/home/linuxbrew

# First-boot script to complete Homebrew setup
COPY build_files/first-boot-setup.sh /usr/libexec/formless-first-boot
RUN chmod +x /usr/libexec/formless-first-boot

# Kernel setup script (manual post-boot installation)
COPY build_files/setup-kernel.sh /usr/local/bin/setup-kernel
RUN chmod +x /usr/local/bin/setup-kernel

# Create state directory for first-boot marker
RUN mkdir -p /var/lib/formless

# First-boot service
COPY build_files/formless-first-boot.service /usr/lib/systemd/system/
RUN systemctl enable formless-first-boot.service

# -----------------------------------------------------------------------------
# 7. Formless User & Integration (using systemd-sysusers for bootc compatibility)
# -----------------------------------------------------------------------------
# Formless service, target, and boot script
COPY build_files/formless.service /usr/lib/systemd/system/
COPY build_files/formless.target /usr/lib/systemd/system/
COPY build_files/formless-boot.sh /usr/libexec/formless-boot
RUN chmod +x /usr/libexec/formless-boot && \
    systemctl set-default formless.target && \
    systemctl enable formless.target && \
    systemctl enable formless.service

# Create formless user via systemd-sysusers (proper bootc method)
COPY build_files/formless-user.conf /usr/lib/sysusers.d/formless.conf
COPY build_files/formless-home.conf /usr/lib/tmpfiles.d/formless-home.conf

# Run sysusers now to create user in image (for chown operations below)
RUN systemd-sysusers /usr/lib/sysusers.d/formless.conf

# Set password for console access (password: formless)
# Note: systemd-sysusers creates locked accounts with "!*" not "!"
RUN sed -i 's|^formless:!\*:|formless:$6$substrate$c8vEgcUeBvCy1CNHsgAYiYtJTIbSCxuuXo.Djmfq/wXD9l5ssIh0JgIaNr29VxNRjuVq.FooPu/fj.3KuGo0H1:|' /etc/shadow

# Set up SSH keys for formless user
COPY build_files/authorized_keys.d/*.pub /tmp/authorized_keys.d/
RUN mkdir -p /var/home/formless/.ssh && \
    chmod 700 /var/home/formless/.ssh && \
    cat /tmp/authorized_keys.d/*.pub > /var/home/formless/.ssh/authorized_keys && \
    chmod 600 /var/home/formless/.ssh/authorized_keys && \
    chown -R formless:formless /var/home/formless && \
    rm -rf /tmp/authorized_keys.d

# Enable passwordless sudo for wheel group
RUN echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd && \
    chmod 440 /etc/sudoers.d/wheel-nopasswd

# Disable getty@tty1 - Formless will handle the console (NO login prompt)
RUN systemctl mask getty@tty1.service 2>/dev/null || true

# Keep getty@tty2 as emergency fallback shell (Ctrl+Alt+F2)
RUN mkdir -p /etc/systemd/system/getty@tty2.service.d && \
    printf '[Unit]\nConditionVirtualization=!container\n[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin formless --noclear %%I $TERM\n' \
    > /etc/systemd/system/getty@tty2.service.d/override.conf

# -----------------------------------------------------------------------------
# 8. Branding & Console Configuration
# -----------------------------------------------------------------------------
RUN echo 'substrate' > /etc/hostname

# Larger console font for HiDPI screens (dev-friendly)
RUN echo 'FONT=latarcyrheb-sun32' > /etc/vconsole.conf

# Quiet boot - minimal console output during startup
RUN mkdir -p /etc/kernel && \
    echo 'quiet loglevel=3 systemd.show_status=false rd.udev.log_level=3 vt.global_cursor_default=0' > /etc/kernel/cmdline

# -----------------------------------------------------------------------------
# 9. Boot Loader Configuration
# -----------------------------------------------------------------------------
# Zero timeout, no menu, no editor
RUN mkdir -p /boot/loader && \
    printf 'timeout 0\ndefault ostree-*\neditor no\n' > /boot/loader/loader.conf

# -----------------------------------------------------------------------------
# 10. Plymouth Boot Splash
# -----------------------------------------------------------------------------
# Set spinner theme (minimal, clean) - DISABLED for clean boot
# RUN plymouth-set-default-theme spinner 2>/dev/null || true

# Replace Fedora watermark with transparent image (cleaner boot) - DISABLED for clean boot
# COPY build_files/watermark-transparent.png /usr/share/plymouth/themes/spinner/watermark.png

# Rebuild initramfs with plymouth (required for early boot splash) - DISABLED for clean boot
# RUN KVER=$(ls /usr/lib/modules | head -n 1) && \
#     dracut --force --add plymouth /boot/initramfs-${KVER}.img ${KVER} 2>/dev/null || \
#     echo "Plymouth initramfs rebuild skipped (will be done on first boot)"

# OS branding
RUN echo 'PRETTY_NAME="Formless Substrate (Fedora Asahi)"' > /etc/os-release.d/substrate.conf || \
    sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Formless Substrate (Fedora Asahi)"/' /etc/os-release

# -----------------------------------------------------------------------------
# 11. Validation
# -----------------------------------------------------------------------------
RUN bootc container lint || echo "Lint warnings (non-fatal)"

# Verify kernel is Asahi
RUN KVER=$(ls /usr/lib/modules | head -n 1) && \
    echo "Kernel: $KVER" && \
    if echo "$KVER" | grep -q "asahi"; then \
        echo "Asahi kernel confirmed"; \
    else \
        echo "WARNING: Non-Asahi kernel detected!" && exit 1; \
    fi

# =============================================================================
# SUBSTRATE MANIFEST
# =============================================================================
# INCLUDED (from base):
#   - Asahi kernel (kernel-16k) with Apple Silicon drivers
#   - Mesa GPU drivers (asahi)
#   - Audio stack (PipeWire + speakersafetyd)
#   - Network (NetworkManager + iwd)
#   - Container runtime (Podman)
#
# ADDED:
#   - Remote access (SSH + Tailscale)
#   - Homebrew bootstrap
#   - Formless service definition
#
# EXCLUDED:
#   - Desktop environment (GNOME/KDE)
#   - Login manager (GDM)
#   - Package manager GUI
#
# PACKAGE MANAGEMENT:
#   System: Immutable (OSTree)
#   User:   Homebrew (/home/linuxbrew/.linuxbrew)
#   Apps:   Podman containers
# =============================================================================
